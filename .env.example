# Copy to .env and fill in. Never commit .env (it is in .gitignore).
# On Render, set these in the dashboard instead (Environment tab).

# ---- Language model: groq (cloud, free tier) or ollama (local)
LLM_PROVIDER=groq
GROQ_API_KEY=
# Don't guess a model id: run `python -m app.list_models` and paste a Qwen or Llama id here.
GROQ_MODEL=

# Used when LLM_PROVIDER=ollama (or EMBED_PROVIDER=ollama):
#   ollama pull qwen2.5:7b
#   ollama pull bge-m3
OLLAMA_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b

# ---- Embeddings: pinecone (hosted llama-text-embed-v2, no Ollama needed) or ollama (bge-m3)
EMBED_PROVIDER=pinecone
EMBED_MODEL=bge-m3
PINECONE_API_KEY=
# Each embedding mode needs its own index. pinecone mode creates this one if it doesn't exist
# and never changes an existing index. For ollama mode, use your old index (e.g. compliance-copilot).
PINECONE_INDEX=compliance-copilot-cloud

# ---- Answering
# Below this similarity the bot answers "not in my documents" without calling the LLM.
# Re-tune with the eval sweep after switching embedding models: the score scales differ.
SCORE_THRESHOLD=0.55
# rules | llm  (llm uses the model's JSON output and falls back to rules on errors)
ROUTER=rules

# ---- Public demo (set PUBLIC_MODE=true on the deployed app)
PUBLIC_MODE=false
RATE_LIMIT_PER_MIN=10
RATE_LIMIT_PER_DAY=60
CACHE_SIZE=500
