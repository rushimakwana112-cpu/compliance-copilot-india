# Copy to .env and fill in. Never commit .env.
PINECONE_API_KEY=
PINECONE_INDEX=compliance-copilot

# Ollama runs locally; pull the models first:
#   ollama pull qwen2.5:7b
#   ollama pull bge-m3
OLLAMA_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b
EMBED_MODEL=bge-m3

# Below this similarity the bot answers "not in my documents" without calling the LLM.
SCORE_THRESHOLD=0.55

# rules | llm  (llm uses Qwen's JSON output and falls back to rules on errors)
ROUTER=rules
